# Server Configuration
PORT=3000
FRONTEND_ORIGIN=http://localhost:5050

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sabai_db
DB_USER=postgres
DB_PASSWORD=your_password

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=your-s3-bucket-name
# Optional: set to public-read if bucket policy allows public objects (else leave blank)
S3_UPLOAD_ACL=public-read

# PostgreSQL SSL (set to true only when connecting to managed DBs requiring SSL)
PGSSL=false
